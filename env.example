# Environment Variables Configuration
# Copy this file to .env.local and fill in your actual values

# Groq API Key (Required - the only AI provider this app uses)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the per-request Groq timeout (milliseconds)
AI_TIMEOUT_MS=20000

# Note: The chat model list and provider order are hardcoded in
# pages/api/chat.js (GROQ_MODELS / AI_PROVIDER_ORDER), not read from env.

# Note: Never commit .env.local to version control
# This file (.env.example) is safe to commit as it contains no real values
