# Environment Variables Configuration
# Copy this file to .env.local and fill in your actual values

# Google Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated Gemini model fallback list
GEMINI_MODEL=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro

# OpenAI API Key (Optional - used as fallback)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI fallback model
OPENAI_MODEL=gpt-4o-mini

# Groq API Key (Recommended - primary provider, matching Gangulys Notes)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: comma-separated Groq model fallback list
GROQ_MODEL=llama-3.1-8b-instant,llama-3.3-70b-versatile,deepseek-r1-distill-llama-70b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_ORDER=groq,gemini,openai

# Optional: speed controls for chat answers
AI_MAX_OUTPUT_TOKENS=1024
AI_TIMEOUT_MS=20000
AI_HISTORY_LIMIT=2

# Note: Never commit .env.local to version control
# This file (.env.example) is safe to commit as it contains no real values
