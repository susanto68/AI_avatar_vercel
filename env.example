# Environment Variables Configuration
# Copy this file to .env.local and fill in your actual values

# Google Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated Gemini model fallback list
GEMINI_MODEL=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-flash-latest

# OpenAI API Key (Optional - used as fallback)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI fallback model
OPENAI_MODEL=gpt-4o-mini

# Optional: speed controls for chat answers
AI_MAX_OUTPUT_TOKENS=300
AI_TIMEOUT_MS=7000
AI_HISTORY_LIMIT=2

# Note: Never commit .env.local to version control
# This file (.env.example) is safe to commit as it contains no real values
